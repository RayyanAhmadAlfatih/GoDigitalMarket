# Copy file ini menjadi .env saat live, lalu isi value asli di .env.
# File .env.example boleh tetap ada sebagai template karena .htaccess sudah memblokir akses file example/dotfile.

APP_URL=https://domain-anda.com
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Alternatif lebih aman: buat akun owner dari /install agar password tersimpan hashed di storage/admin-users.json.
# ADMIN_PASSWORD_HASH dapat dipakai hanya jika Anda generate hash sendiri.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TIMEOUT=7200
INSTALLER_ENABLED=false
CDN_URL=

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Storage mode foundation
# Default aman: file. Pilihan: file, hybrid, mysql.
# MySQL hanya aktif per collection setelah admin mengaktifkan di /admin/storage-database.
STORAGE_DRIVER=file
STORAGE_MYSQL_PRODUCTS=false
STORAGE_MYSQL_ARTICLES=false
STORAGE_MYSQL_LANDING_PAGES=false
STORAGE_MYSQL_FORM_SUBMISSIONS=false
STORAGE_MYSQL_INQUIRIES=false
STORAGE_MYSQL_ORDERS=false
STORAGE_MYSQL_PAYMENT_PROOFS=false
STORAGE_MYSQL_ANALYTICS_EVENTS=false
STORAGE_MYSQL_EMAIL_LOGS=false
STORAGE_MYSQL_ACTIVITY_LOGS=false

ENABLE_LEAD_TRACKING=true

# Inquiry/Form Lead
ENABLE_INQUIRY_FORM=true

# Simple Order / Checkout Draft
ENABLE_ORDER_FORM=true

# Payment readiness (belum payment gateway otomatis)
ENABLE_PAYMENT_READINESS=true
PAYMENT_QRIS_ENABLED=false
PAYMENT_PROVIDER=manual
PAYMENT_PUBLIC_LABEL=QRIS/Transfer setelah konfirmasi admin

# Manual invoice/payment instruction foundation (belum payment gateway otomatis)
PAYMENT_DEFAULT_DUE_DAYS=3
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=
PAYMENT_QRIS_NOTE=

# Dedicated checkout/order success
ENABLE_ORDER_SUCCESS_PAGE=true
ORDER_SUCCESS_WHATSAPP_CONFIRMATION=true

# Mini CRM Follow-up History & Reminder
ENABLE_MINI_CRM=true

# Email Notification Foundation + SMTP Readiness
# Default aman: false/log. Aktifkan setelah konfigurasi email sudah benar.
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_TRANSPORT=log
EMAIL_ADMIN_TO=
EMAIL_FROM=
EMAIL_FROM_NAME=UMKM Commerce Template
EMAIL_REPLY_TO=
EMAIL_SEND_CUSTOMER_CONFIRMATION=true

# SMTP opsional jika EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_ENCRYPTION=tls

# Email notification rules & template polish
# Set false jika jenis email tertentu tidak ingin dikirim.
EMAIL_RULE_ADMIN_INQUIRY_CREATED=true
EMAIL_RULE_CUSTOMER_INQUIRY_CONFIRMATION=true
EMAIL_RULE_ADMIN_ORDER_CREATED=true
EMAIL_RULE_CUSTOMER_ORDER_CONFIRMATION=true
EMAIL_RULE_CUSTOMER_ORDER_STATUS_LINK=true
EMAIL_RULE_CUSTOMER_INVOICE_LINK=true
EMAIL_RULE_TEST_EMAIL=true
EMAIL_TEMPLATE_FOOTER=Email ini dikirim otomatis. Silakan balas email ini atau hubungi admin WhatsApp jika butuh bantuan.

# Manual Payment Settings / Transfer Profile
# Jika storage/payment-settings.json belum dibuat, nilai ini dipakai sebagai fallback awal.
PAYMENT_QRIS_IMAGE_URL=
PAYMENT_DEFAULT_INSTRUCTION=Admin akan mengonfirmasi stok, jadwal, nominal, dan metode pembayaran yang paling sesuai sebelum pembayaran dilakukan.
PAYMENT_DEFAULT_PUBLIC_NOTE=Invoice ini adalah draft instruksi pembayaran manual. Pembayaran dianggap valid setelah admin mengonfirmasi dana/bukti pembayaran.

# Payment Proof Upload / Manual Payment Confirmation
# Bukti pembayaran tetap direview manual oleh admin, bukan payment gateway otomatis.
ENABLE_PAYMENT_PROOF_UPLOAD=true
PAYMENT_PROOF_MAX_MB=5

# Payment Reminder / Invoice Follow-up
# Reminder ini manual dari dashboard, bukan cron otomatis.
ENABLE_PAYMENT_REMINDERS=true
PAYMENT_REMINDER_DEFAULT_DAYS=1,2

# Admin Activity Log + Data Health
ENABLE_ADMIN_ACTIVITY_LOG=true

# Customer Account-less Order Tracking
# Customer bisa cek status order tanpa login memakai nomor order + nomor WhatsApp.
ENABLE_CUSTOMER_ORDER_LOOKUP=true

# Payment Gateway Bridge (Midtrans/Xendit/Flip payment link readiness)
# Default aman: false. Credential utama disarankan diinput via /admin/payment-gateway.
# Provider akan membuat payment link hanya untuk produk/metode yang mengizinkan pembayaran otomatis.
PAYMENT_GATEWAY_ENABLED=false
PAYMENT_GATEWAY_PROVIDER=midtrans
PAYMENT_GATEWAY_DEFAULT_EXPIRY_HOURS=24

# Analytics & Marketing Attribution
# Setting utama dikelola via /admin/analytics dan tersimpan di storage/analytics-settings.json.
# Default aman: tracking/pixel bisa dinonaktifkan dari dashboard admin.

# Multi Pixel & Ads Platform Settings
# Disarankan GTM only untuk production. Direct pixel/hybrid hanya aktif jika di-enable dari admin.

# Server-Side Conversion API Foundation
# Setting CAPI/Events API dikelola via /admin/analytics dan tersimpan di storage/server-conversion-settings.json.
# Default aman: nonaktif. Token Meta/TikTok tidak perlu ditulis di .env jika diinput via dashboard.

# Conversion API Monitoring Center + Scheduled Retry Foundation
# Cron token dikelola via /admin/analytics dan tersimpan di storage/server-conversion-settings.json.
# Default aman: scheduled retry disabled sampai admin mengaktifkan dan mengisi token cron.

# Penyimpanan akses Google Ads
# Akses Google Ads dikelola dari /admin/analytics dan tersimpan aman di folder storage.
# Isi GOOGLE_ADS_VAULT_KEY di VPS/hosting agar data akses tetap bisa dibaca setelah pindah server.
# Jangan bagikan file akses Google Ads ke publik.
GOOGLE_ADS_VAULT_KEY=

# Google Ads Offline Conversion Sender Beta
# Sender beta diatur dari /admin/analytics. Default aman: disabled + validate-only mode.
# Matikan validate-only hanya setelah Customer ID, Conversion Action, OAuth, developer token, dan click ID queue valid.

# Mailketing Buyer List ID
# Buyer List ID untuk lead/order yang sudah bayar dikelola via /admin/marketing-integrations.
# Tidak perlu ditulis di .env agar lebih mudah diedit admin tanpa akses server.

# Production Release Candidate / Final Hardening
# Setelah upload source, buka /admin/production-readiness untuk cek readiness final.
# Wajib sebelum live: isi APP_URL domain final dan ADMIN_PASSWORD kuat.

# Cloud Backup & Data Sync
# Bisa diatur juga dari dashboard admin: Sistem > Backup & Sync Data.
# Gunakan Google Apps Script Web App sebagai jembatan ringan ke Google Sheets/Drive.
# CLOUD_SYNC_WEBHOOK_TOKEN harus sama dengan Script Properties SYNC_TOKEN di Apps Script.
CLOUD_SYNC_WEBHOOK_URL=
CLOUD_SYNC_WEBHOOK_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: token khusus koneksi langsung Looker Studio.
# Jika kosong, dashboard bisa memakai token Backup & Sync Data sebagai fallback.
LOOKER_STUDIO_CONNECTOR_TOKEN=

# Cloud Sync Reliability Guard
# Bisa diatur juga dari menu Sistem > Backup & Sync Data.
CLOUD_SYNC_MODE=replace
CLOUD_SYNC_MAX_ROWS=1000
CLOUD_SYNC_RETRY_ATTEMPTS=1
CLOUD_SYNC_TIMEOUT_SECONDS=15
